# Copy this file to `.env` and fill in real values.
# The `.env` file holds secrets and is NEVER committed to git.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (production / PostgreSQL only) ---
# Local development uses SQLite automatically and ignores these.
DB_NAME=alsayyad
DB_USER=alsayyad
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Store contact info (تظهر للزبائن بصفحة «تواصل معنا» والفوتر) ---
# ⚠️ إن تُركت فارغة يستعمل الكود قيماً افتراضية شخصية — اضبطها قبل النشر.
STORE_PHONE=0912345678
STORE_WHATSAPP=963912345678
STORE_EMAIL=info@example.com

# --- Email (إشعار «طلب جديد» للمالك) ---
# بلا EMAIL_HOST تُطبع الرسائل بالكونسول فقط — يعني لن يصلك إشعار بأي طلب.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
ORDER_NOTIFICATION_EMAIL=

# --- Backups ---
BACKUP_DIR=/srv/backups/alsayyad
